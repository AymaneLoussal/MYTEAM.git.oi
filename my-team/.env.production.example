APP_NAME=FTMBALL
APP_ENV=production
APP_KEY=REPLACE_WITH_EXISTING_OR_SECURELY_GENERATED_KEY
APP_DEBUG=false
APP_URL=https://example.com
TRUSTED_PROXIES=REPLACE_WITH_PROXY_CIDR_OR_IPS
LOG_CHANNEL=stderr
LOG_LEVEL=warning
DB_CONNECTION=sqlite
DB_DATABASE=/app/database/ftmball.sqlite
RUN_MIGRATIONS=false
SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=sync
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-account@gmail.com
MAIL_PASSWORD=USE_SECRET_MANAGER
MAIL_FROM_ADDRESS=your-account@gmail.com
MAIL_FROM_NAME=FTMBALL
